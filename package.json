{
  "name": "@mortz.dev/opencode-voice",
  "version": "0.1.0",
  "description": "Speech-to-text and text-to-speech for OpenCode (V2). Record voice prompts with whisper-cpp or an STT API, hear responses via Piper TTS, with LLM normalization through any OpenAI-compatible endpoint.",
  "keywords": [
    "opencode",
    "piper",
    "plugin",
    "speech-to-text",
    "stt",
    "text-to-speech",
    "tts",
    "voice",
    "whisper"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortezaPRK/opencode-voice.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "lint": "oxlint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "check": "npm run lint && npm run fmt && npm run typecheck",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.2"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "^26.6.5",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
